# Generated by generate_neuroabs_cases.py from ../../nerv/unique/ric3.toml.
# Self-contained: no iter/ or insn_*_ch0.sv dependency.
read_verilog -sv -I. rvfi_unique_check.sv
read_verilog -sv -I. nerv.sv
read_verilog -sv -I. wrapper.sv
read_verilog -sv -I. tb.sv
prep -flatten -nordff -top testbench
chformal -early
memory
async2sync
chformal -assume -early
chformal -live -fair -cover -remove
opt_clean
setundef -anyseq
opt -keepdc -fast
check
hierarchy -simcheck
dffunmap
# Start from the post-reset state.  ric3.toml declares `reset`; without this
# writeback the model starts from an arbitrary, unreachable state.
async2sync
sim -clock clock -reset reset -rstlen 1 -n 1 -w testbench
write_btor problem.btor2
