+def _fit_width(expr, size):
+    """Resize a bit-vector to `size` following Verilog's implicit extension."""
+    current = expr.size()
+    if current == size:
+        return expr
+    if current < size:
+        return ZeroExt(size - current, expr)
+    return Extract(size - 1, 0, expr)
+
+def fit_width_pair(lhs, rhs):
+    """Give two bit-vectors of different widths a common width.
+
+    A literal is resized to the width of the symbolic operand, which is what
+    Verilog does for an unsized or partially sized constant on either side of
+    an assignment or a binary expression. Two literals are widened to the wider
+    of the two.
+    """
+    lhs_const = isinstance(lhs, BitVecNumRef)
+    rhs_const = isinstance(rhs, BitVecNumRef)
+    if rhs_const and not lhs_const:
+        return lhs, _fit_width(rhs, lhs.size())
+    if lhs_const and not rhs_const:
+        return _fit_width(lhs, rhs.size()), rhs
+    size = max(lhs.size(), rhs.size())
+    return _fit_width(lhs, size), _fit_width(rhs, size)  
 
 
 
