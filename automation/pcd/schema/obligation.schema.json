{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fassert.local/pcd/schema/obligation.schema.json",
  "title": "PCD obligation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "role", "kind", "phase", "model", "requires", "provides", "certificate"],
  "properties": {
    "schema_version": {"const": "pcd-obligation/0.1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "role": {
      "enum": ["invariant", "update", "algebra", "terminal", "temporal",
               "select", "operand", "observe", "rtl_link", "transfer",
               "abstraction_gate", "coverage", "interface", "compose", "tcb"]
    },
    "kind": {
      "enum": ["inductive", "poly", "linear", "guarded", "ordering",
               "macro_step", "over_approx", "equivalence", "replay", "tcb"]
    },
    "phase": {"enum": ["entry", "loop", "exit", "any"]},
    "model": {"type": "string", "pattern": "^[a-z0-9]+:[0-9a-f]{64}$"},
    "statement": {"type": "string"},
    "requires": {
      "type": "array",
      "items": {"$ref": "#/$defs/premise"}
    },
    "provides": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/guarantee"}
    },
    "certificate": {"$ref": "#/$defs/certificate"},
    "reuse": {"$ref": "#/$defs/reuse"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "cut": {"$ref": "#/$defs/cut"},
    "helper": {"$ref": "#/$defs/helper"},
    "simultaneous_group": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"required": ["role"], "properties": {"role": {"const": "coverage"}}},
      "then": {"required": ["coverage"]}
    }
  ],
  "$defs": {
    "premise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "guarantee"],
      "properties": {
        "node": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "guarantee": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "frame": {"enum": ["current", "next", "both"]}
      }
    },
    "guarantee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expr", "sort"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "expr": {"type": "string", "minLength": 1},
        "sort": {"type": "string", "pattern": "^(Bool|Int|BV[0-9]+|SMT)$"},
        "binding": {
          "oneOf": [
            {"type": "object", "additionalProperties": false,
             "required": ["kind", "property"],
             "properties": {"kind": {"const": "btor-bad"}, "property": {"type": "string", "minLength": 1}}},
            {"type": "object", "additionalProperties": false,
             "required": ["kind", "expression"],
             "properties": {"kind": {"const": "btor-expression"}, "expression": {"type": "object"}}}
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "note": {"type": "string"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "tool", "version", "model_sha256", "log_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "command": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "array", "minItems": 1, "items": {"type": "string"}}
          ]
        },
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "model_sha256": {"type": "string", "pattern": "^[a-z0-9]+:[0-9a-f]{64}$"},
        "log": {"type": "string", "minLength": 1},
        "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cwd": {"type": "string"},
        "seconds": {"type": "number", "minimum": 0},
        "engine_wall_seconds": {"type": "number", "minimum": 0},
        "engine_seconds": {"type": "number", "minimum": 0},
        "bmc_seconds": {"type": ["number", "null"], "minimum": 0},
        "ind_seconds": {"type": ["number", "null"], "minimum": 0},
        "timing_source": {"type": "string", "minLength": 1},
        "statistic": {"type": ["string", "null"]},
        "statistic_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "certificate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence", "format", "checker", "verdict", "goal"],
          "properties": {
            "evidence": {"const": "CHECKED"},
            "format": {"enum": ["poly", "smt-implication", "smt-induction", "miter", "witness", "transfer", "btor-projection", "btor-smt"]},
            "checker": {"type": "string", "minLength": 1},
            "verdict": {"const": "proved"},
            "goal": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
            "payload": {"type": "object"},
            "artifact": {"$ref": "#/$defs/artifact"},
            "notes": {"type": "string"}
          },
          "allOf": [
            {"anyOf": [{"required": ["payload"]}, {"required": ["artifact"]}]}
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence", "format", "verdict", "goal", "run"],
          "properties": {
            "evidence": {"const": "REPLAY"},
            "format": {"const": "replay"},
            "verdict": {"enum": ["proved", "bmc_clean", "unknown", "cex", "error"]},
            "goal": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
            "run": {"$ref": "#/$defs/run"},
            "assertion": {"$ref": "#/$defs/assertion"},
            "artifact": {"$ref": "#/$defs/artifact"},
            "notes": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence", "format", "verdict", "tcb"],
          "properties": {
            "evidence": {"const": "TCB"},
            "format": {"const": "tcb"},
            "verdict": {"const": "assumed"},
            "tcb": {"type": "string", "minLength": 1},
            "kind": {"enum": ["frontend", "engine", "checker", "isa_model"]},
            "notes": {"type": "string"}
          }
        }
      ]
    },
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_model", "assumption_match", "transfer_node"],
      "properties": {
        "source_model": {"type": "string", "pattern": "^[a-z0-9]+:[0-9a-f]{64}$"},
        "assumption_match": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["model", "width", "guards", "phase", "transition"]}
        },
        "transfer_node": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "note": {"type": "string"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guards", "exhaustive"],
      "properties": {
        "guards": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/guard"}
        },
        "exhaustive": {"type": "boolean"},
        "checked_by": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expr"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "expr": {"type": "string", "minLength": 1}
      }
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "entry", "step", "exit", "link"],
      "properties": {
        "boundary": {"type": "string", "minLength": 1},
        "entry": {"type": "array", "items": {"$ref": "#/$defs/premise"}},
        "step": {"type": "array", "items": {"$ref": "#/$defs/premise"}},
        "exit": {"type": "array", "items": {"$ref": "#/$defs/premise"}},
        "link": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/premise"}},
        "guards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/guard"}},
        "coverage": {"$ref": "#/$defs/premise"},
        "assumption_cut": {"type": "boolean"},
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
        },
        "note": {"type": "string"}
      }
    },
    "helper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["monitor", "assumption", "submodel"]},
        "note": {"type": "string"}
      }
    }
  }
}
