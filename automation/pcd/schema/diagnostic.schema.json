{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fassert.local/pcd/schema/diagnostic.schema.json",
  "title": "PCD diagnostic record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case",
    "run_id",
    "model_sha256",
    "source",
    "evidence",
    "proof",
    "status",
    "bmc",
    "properties",
    "ctis",
    "calls",
    "artifacts",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "pcd-diagnostic/0.1"},
    "case": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "run_id": {"type": "string", "minLength": 1},
    "model_sha256": {"type": "string", "pattern": "^[a-z0-9]+:[0-9a-f]{64}$"},
    "source": {"type": "object", "additionalProperties": true},
    "evidence": {"const": "DIAGNOSTIC"},
    "proof": {"const": false},
    "status": {"enum": ["cti", "no_cti", "cex", "unknown", "error"]},
    "bmc": {"enum": ["clean", "cex", "unknown"]},
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "name", "result", "selected"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "name": {"type": "string"},
          "result": {"enum": ["not_inductive", "inductive", "unknown", "error"]},
          "selected": {"type": "boolean"}
        }
      }
    },
    "ctis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["property_index", "property_name", "status", "select", "artifacts", "cti", "vcd"],
        "properties": {
          "property_index": {"type": "integer", "minimum": 0},
          "property_name": {"type": "string"},
          "status": {"enum": ["cti", "unknown"]},
          "reason": {"type": "string"},
          "state": {"type": "string"},
          "select": {"type": "object", "additionalProperties": true},
          "artifacts": {"type": "object", "additionalProperties": true},
          "cti": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "additionalProperties": true}
            ]
          },
          "vcd": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "additionalProperties": true}
            ]
          }
        }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "command", "returncode", "timed_out", "seconds", "sandboxed", "log", "log_sha256"],
        "properties": {
          "phase": {"type": "string", "minLength": 1},
          "command": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "array", "minItems": 1, "items": {"type": "string"}}
            ]
          },
          "cwd": {"type": "string"},
          "returncode": {"type": "integer"},
          "timed_out": {"type": "boolean"},
          "seconds": {"type": "number", "minimum": 0},
          "sandboxed": {"type": "boolean"},
          "log": {"type": "string", "minLength": 1},
          "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "artifacts": {"type": "object", "additionalProperties": true},
    "notes": {"type": "array", "items": {"type": "string"}},
    "selected_property_index": {
      "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]
    },
    "timeout_s": {"type": "integer", "minimum": 1}
  }
}
