{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fassert.local/pcd/schema/proposal.schema.json",
  "title": "PCD planner proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case", "planner", "nodes", "targets"],
  "properties": {
    "schema_version": {"const": "pcd-proposal/0.1"},
    "case": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/target"}
    },
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "premise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "guarantee"],
      "properties": {
        "node": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "guarantee": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
      }
    },
    "guarantee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expr", "sort"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "expr": {"type": "string", "minLength": 1},
        "sort": {"type": "string", "pattern": "^(Bool|Int|BV[0-9]+|SMT)$"},
        "binding": {
          "oneOf": [
            {"type": "object", "additionalProperties": false,
             "required": ["kind", "property"],
             "properties": {"kind": {"const": "btor-bad"}, "property": {"type": "string", "minLength": 1}}},
            {"type": "object", "additionalProperties": false,
             "required": ["kind", "expression"],
             "properties": {"kind": {"const": "btor-expression"}, "expression": {"type": "object"}}}
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "kind", "phase", "statement", "requires", "provides", "certificate_hint"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "role": {
          "enum": ["invariant", "update", "algebra", "terminal", "temporal",
                   "select", "operand", "observe", "rtl_link", "transfer",
                   "abstraction_gate", "coverage", "interface", "compose", "tcb"]
        },
        "kind": {
          "enum": ["inductive", "poly", "linear", "guarded", "ordering",
                   "macro_step", "over_approx", "equivalence", "replay", "tcb"]
        },
        "phase": {"enum": ["entry", "loop", "exit", "any"]},
        "statement": {"type": "string", "minLength": 1},
        "requires": {
          "type": "array",
          "items": {"$ref": "#/$defs/premise"}
        },
        "provides": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/guarantee"}
        },
        "certificate_hint": {"$ref": "#/$defs/certificate_hint"},
        "cut": {"$ref": "#/$defs/cut"},
        "helper": {"$ref": "#/$defs/helper"}
      }
    },
    "certificate_hint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence", "goal"],
          "properties": {
            "evidence": {"const": "REPLAY"},
            "format": {"const": "replay"},
            "goal": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
            "engine": {"type": "string", "minLength": 1},
            "backend": {"type": "string", "minLength": 1},
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string"}
            },
            "timeout_s": {"type": "integer", "minimum": 1},
            "property_index": {"type": "integer", "minimum": 0},
            "assertion_file": {"type": "string", "minLength": 1},
            "assertion_name": {"type": "string", "minLength": 1},
            "note": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence", "format", "goal"],
          "properties": {
            "evidence": {"const": "CHECKED"},
            "format": {"enum": ["poly", "smt-implication", "smt-induction", "btor-smt"]},
            "goal": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
            "checker": {"type": "string", "minLength": 1},
            "payload": {"type": "object"},
            "artifact": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "note": {"type": "string"}
              }
            },
            "note": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence", "tcb"],
          "properties": {
            "evidence": {"const": "TCB"},
            "format": {"const": "tcb"},
            "tcb": {"type": "string", "minLength": 1},
            "kind": {"enum": ["frontend", "engine", "checker", "isa_model"]},
            "note": {"type": "string"}
          }
        }
      ]
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expr"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "expr": {"type": "string", "minLength": 1}
      }
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "entry", "step", "exit", "link"],
      "properties": {
        "boundary": {"type": "string", "minLength": 1},
        "entry": {"type": "array", "items": {"$ref": "#/$defs/premise"}},
        "step": {"type": "array", "items": {"$ref": "#/$defs/premise"}},
        "exit": {"type": "array", "items": {"$ref": "#/$defs/premise"}},
        "link": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/premise"}},
        "guards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/guard"}},
        "coverage": {"$ref": "#/$defs/premise"},
        "assumption_cut": {"type": "boolean"},
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
        },
        "note": {"type": "string"}
      }
    },
    "helper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["monitor", "assumption", "submodel"]},
        "note": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "goal", "requires", "composition_hint"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "goal": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "requires": {
          "type": "array",
          "items": {"$ref": "#/$defs/premise"}
        },
        "tcb": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "uniqueItems": true
        },
        "composition_hint": {"$ref": "#/$defs/composition_hint"}
      }
    },
    "composition_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["STRUCTURAL", "CHECKED"]},
        "checker": {"const": "z3-implication"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["premises", "goal", "smt2"],
          "properties": {
            "premises": {
              "type": "array",
              "items": {"$ref": "#/$defs/premise"}
            },
            "goal": {"type": "string", "minLength": 1},
            "smt2": {"type": "string", "minLength": 1},
            "timeout_ms": {"type": "integer", "minimum": 1}
          }
        },
        "notes": {"type": "string"}
      }
    }
  }
}
